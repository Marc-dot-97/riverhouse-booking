{
  "name": "riverhouse-booking",
  "version": "0.1.0",
  "description": "Shared house booking calendar (timeshare) - month calendar, no overlapping stays, Outlook feed, installable PWA. Node + Express + EJS + MySQL.",
  "type": "module",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
