<%- include("partials/header") %>
<div class="cal-layout">
  <section class="cal">
    <div class="cal__head">
      <h1 class="display">
        <%= month.name %> <em><%= month.year %></em>
      </h1>
      <div class="cal__nav">
        <a class="btn btn--outline btn--sm" href="/?m=<%= todayMonth %>">Today</a>
        <a class="round-btn" href="/?m=<%= prevMonth %>" aria-label="Previous month">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="round-btn" href="/?m=<%= nextMonth %>" aria-label="Next month">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M8 4l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>

    <div class="card cal__card">
      <div class="cal__grid cal__weekdays" aria-hidden="true">
        <% ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"].forEach(function (d) { %>
          <span><span class="wd-long"><%= d %></span><span class="wd-short"><%= d[0] %></span></span>
        <% }) %>
      </div>
      <div class="cal__grid" role="grid" aria-label="<%= month.name %> <%= month.year %>">
        <% weeks.forEach(function (week) { %>
          <% week.forEach(function (c) {
               const free = !c.booking && !c.isPast;
               const editable = c.booking && c.booking.canEdit;
               const cls = ["day", c.inMonth ? "" : "day--out", c.isPast ? "day--past" : "", free ? "day--free" : ""].join(" ");
               const label = c.booking ? c.booking.DisplayName + " staying" : (c.isPast ? "" : "free, book from this day");
          %>
            <% if (free) { %>
              <a class="<%= cls %>" href="/bookings/new?checkIn=<%= c.iso %>" aria-label="<%= c.iso %>, <%= label %>">
            <% } else if (editable) { %>
              <a class="<%= cls %> day--editable" href="/bookings/<%= c.booking.BookingId %>/edit" title="<%= c.booking.DisplayName %> – click to change" aria-label="<%= c.iso %>, <%= c.booking.DisplayName %> staying, change this stay">
            <% } else { %>
              <div class="<%= cls %>" <% if (c.booking) { %>title="<%= c.booking.DisplayName %>"<% } %>>
            <% } %>
                <span class="day__num <%= c.isToday ? 'day__num--today' : '' %>"><%= c.day %></span>
                <% if (c.bar) { %>
                  <span class="bar <%= c.bar.isStart ? 'bar--start' : '' %> <%= c.bar.isEnd ? 'bar--end' : '' %>"
                        style="background: <%= c.booking.Colour %>; color: <%= c.booking.TextColour %>;">
                    <% if (c.bar.showLabel) { %>
                      <span class="bar__name" style="--span: <%= c.bar.span %>;"><%= c.booking.DisplayName %></span>
                      <span class="bar__init"><%= c.booking.Initials %></span>
                    <% } %>
                  </span>
                <% } %>
            <% if (free || editable) { %></a><% } else { %></div><% } %>
          <% }) %>
        <% }) %>
      </div>
    </div>
  </section>

  <aside class="side">
    <div class="card side__card">
      <h2 class="eyebrow">Who's going this month</h2>
      <% if (!thisMonth.length) { %>
        <p class="muted">Nobody has booked yet this month.</p>
      <% } %>
      <% thisMonth.forEach(function (b) { %>
        <div class="stay">
          <span class="avatar avatar--lg" style="background: <%= b.Colour %>; color: <%= b.TextColour %>; border-color: <%= b.Colour %>;"><%= b.Initials %></span>
          <div class="stay__body">
            <span class="stay__name"><%= b.DisplayName %> <% if (b.isMine) { %><span class="pill">You</span><% } %></span>
            <span class="muted"><%= b.range %> · <%= b.nights %> night<%= b.nights === 1 ? "" : "s" %> · <%= b.Guests %> guest<%= b.Guests === 1 ? "" : "s" %></span>
            <% if (b.Note) { %><span class="stay__note"><%= b.Note %></span><% } %>
            <% if (b.canEdit) { %>
              <div class="stay__actions">
              <a class="stay__link" href="/bookings/<%= b.BookingId %>/edit">Change dates</a>
              <details class="confirm">
                <summary>Cancel stay</summary>
                <form method="post" action="/bookings/<%= b.BookingId %>/cancel">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <span>Free up these dates for everyone?</span>
                  <button class="btn btn--danger btn--sm" type="submit">Yes, cancel</button>
                </form>
              </details>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="card side__card">
      <h2 class="eyebrow">Open dates</h2>
      <% if (!open.length) { %>
        <p class="muted">No open dates left this month.</p>
      <% } %>
      <% open.forEach(function (r) { %>
        <a class="open" href="/bookings/new?checkIn=<%= r.startISO %>&checkOut=<%= r.endISO %>">
          <span><%= r.range %></span>
          <span class="muted"><%= r.nights %> night<%= r.nights === 1 ? "" : "s" %></span>
        </a>
      <% }) %>
    </div>
  </aside>
</div>

<a href="/bookings/new" class="btn btn--gold fab">
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  Book a stay
</a>
<%- include("partials/footer") %>
