<%- include("partials/header") %>
<div class="narrow">
  <a href="/" class="back-link">
    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Back to calendar
  </a>

  <% if (booking) { %>
    <h1 class="display">Change your <em>stay</em></h1>
    <p class="muted lead">Move, shorten or extend the stay. Nobody else's dates are affected – if the new dates overlap another family, you'll be told.</p>
    <div class="original">
      <span class="avatar avatar--lg" style="background: <%= booking.Colour %>; color: <%= booking.TextColour %>; border-color: <%= booking.Colour %>;"><%= booking.Initials %></span>
      <span><strong><%= booking.DisplayName %></strong><br><span class="muted">Currently booked: <%= originalRange %></span></span>
    </div>
  <% } else { %>
    <h1 class="display">Book a <em>stay</em></h1>
    <p class="muted lead">Pick when you arrive and when you leave. Someone else can arrive on the day you leave.</p>
  <% } %>

  <% if (error) { %>
    <div class="alert alert--error" role="alert"><%= error %></div>
  <% } %>

  <form class="card form" method="post" action="<%= booking ? '/bookings/' + booking.BookingId : '/bookings' %>" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form__row">
      <div class="field">
        <label for="checkIn">Arrive</label>
        <% if (booking && started) { %>
          <input id="checkIn" name="checkIn" type="date" value="<%= values.checkIn %>" readonly aria-describedby="startedNote">
        <% } else { %>
          <input id="checkIn" name="checkIn" type="date" required min="<%= today %>" value="<%= values.checkIn %>">
        <% } %>
      </div>
      <div class="field">
        <label for="checkOut">Leave</label>
        <input id="checkOut" name="checkOut" type="date" required min="<%= today %>" value="<%= values.checkOut %>">
      </div>
    </div>
    <% if (booking && started) { %>
      <p class="muted" id="startedNote">This stay has already started, so only the departure date can change.</p>
    <% } %>
    <p class="muted" id="nights" aria-live="polite"></p>
    <div class="field">
      <label for="guests">Number of guests</label>
      <input id="guests" name="guests" type="number" min="1" max="30" required value="<%= Number.isInteger(values.guests) ? values.guests : 2 %>">
    </div>
    <div class="field">
      <label for="note">Note for the other owners <span class="muted">(optional)</span></label>
      <input id="note" name="note" type="text" maxlength="500" placeholder="e.g. Bringing the boat" value="<%= values.note %>">
    </div>
    <button class="btn btn--gold btn--block" type="submit"><%= booking ? "Save changes" : "Book my stay" %></button>
    <% if (booking) { %>
      <a class="btn btn--outline btn--block" href="/?m=<%= values.checkIn.slice(0, 7) %>">Keep it as it is</a>
    <% } %>
  </form>
</div>
<%- include("partials/footer") %>
