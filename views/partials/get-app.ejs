<%# Install options: the PWA prompt (Chrome/Edge/Android), the Android APK when uploaded, and an iPhone hint. %>
<div class="get-app">
  <button class="btn btn--navy btn--block" type="button" data-install hidden>
    <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2.5v9M5.5 8L9 11.5 12.5 8M3 14.5h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Install the app
  </button>
  <% if (typeof androidApk !== "undefined" && androidApk) { %>
    <a class="btn btn--outline btn--block" href="<%= androidApk %>" download data-android-only>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 18.5h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      Get the Android app
    </a>
  <% } %>
  <p class="get-app__ios" data-ios-only hidden>
    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 2.5v10M6.5 6L10 2.5 13.5 6M5 9.5H4v8h12v-8h-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>On iPhone or iPad: in <strong>Safari</strong>, tap <strong>Share</strong>, then <strong>Add to Home Screen</strong>. The app opens full-screen from your home screen.</span>
  </p>
</div>
