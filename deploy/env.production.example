# Riverhouse - PRODUCTION settings (10.10.1.2)
# The installer copies this to C:\Apps\riverhouse-booking\.env the first time.
# Fill in every value that is wrapped in double angle brackets, save, then run install.ps1 again.

NODE_ENV=production
PORT=3010
# Only IIS on this same server may talk to the app directly:
HOST=127.0.0.1
BASE_URL=https://rh-bookings.primebridge.co.za
# A NEW long random string (different from your PC). Make one in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<<PASTE_A_NEW_RANDOM_STRING>>

# --- MySQL on this server ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=riverhouse_booking
DB_USER=riverhouse_app
DB_PASSWORD=<<THE_PROD_PASSWORD_FROM_SCRIPT_001>>
DB_SSL=false

HOUSE_NAME=Riverhouse

# --- Email (same Entra app as on your PC; run "npm run mail-signin" once on this server) ---
MAIL_MODE=graph
SMTP_USER=Leopardcreek@outlook.com
MAIL_FROM="Riverhouse" <Leopardcreek@outlook.com>
MS_CLIENT_ID=b069c2bf-5774-403e-98f0-c2d27c0a12d4
MS_TENANT=consumers

# --- Android app (fill in after building the APK - see android/README.md) ---
ANDROID_PACKAGE_NAME=za.co.primebridge.rhbookings
ANDROID_CERT_SHA256=
