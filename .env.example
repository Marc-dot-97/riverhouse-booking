# Copy this file to .env (never commit .env) and fill in your values.

# --- Web server ---
PORT=3000
NODE_ENV=development
# Long random string. In PowerShell:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Public address people use to reach the site (used in the Outlook calendar link)
BASE_URL=http://localhost:3000

# --- MySQL ---
# Dev/QA server: 10.10.1.4   |   MySQL on your own PC: localhost
DB_HOST=10.10.1.4
DB_PORT=3306
DB_NAME=riverhouse_booking
DB_USER=riverhouse_app
DB_PASSWORD=
# Set DB_SSL=true if the MySQL server requires encrypted connections (e.g. cloud-hosted MySQL).
DB_SSL=false

# --- House details shown in the app ---
HOUSE_NAME=Riverhouse

# --- Email (booking notifications from the house mailbox) ---
# log    = don't send, just print emails in the terminal (default - safe for development)
# graph  = send through Microsoft Graph with a Microsoft sign-in (recommended for Outlook.com)
# oauth2 = send through Outlook.com SMTP with a Microsoft sign-in
# smtp   = send with an SMTP username + password / app password
MAIL_MODE=log
SMTP_USER=Leopardcreek@outlook.com
MAIL_FROM="Riverhouse" <Leopardcreek@outlook.com>
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
# Only for MAIL_MODE=smtp:
SMTP_PASSWORD=
# Only for MAIL_MODE=graph / oauth2 - the "Application (client) ID" of your app registration (see README, Email):
MS_CLIENT_ID=
MS_TENANT=consumers
