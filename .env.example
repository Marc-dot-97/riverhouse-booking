# Copy this file to .env (never commit .env) and fill in your values.

# --- Web server ---
PORT=3000
NODE_ENV=development
# Long random string. In PowerShell:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Public address people use to reach the site (used in the Outlook calendar link)
BASE_URL=http://localhost:3000

# --- MySQL ---
# Dev/QA server: 10.10.1.4   |   MySQL on your own PC: localhost
DB_HOST=10.10.1.4
DB_PORT=3306
DB_NAME=riverhouse_booking
DB_USER=riverhouse_app
DB_PASSWORD=
# Set DB_SSL=true if the MySQL server requires encrypted connections (e.g. cloud-hosted MySQL).
DB_SSL=false

# --- House details shown in the app ---
HOUSE_NAME=Riverhouse
